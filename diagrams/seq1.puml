@startuml
title Sequence - Create Reservation Request

actor Professor as prof
participant CommandBus
participant CreateReservationCommand as CreateCmd
participant ReservationService as Service
participant FacultyPolicyValidator as PolicyV
participant ScheduleConflictValidator as ConflictV
participant SchedulingService as Scheduling
participant DatabaseConnection as DB
participant EventBus as Bus

prof -> CommandBus : dispatch(CreateReservationCommand)
CommandBus -> CreateCmd : execute(service)
CreateCmd -> Service : submit(req, actor)

Service -> PolicyV : validate(req, actor)
PolicyV --> Service : ValidationResult.ok()

Service -> ConflictV : validate(req, actor)
ConflictV -> Scheduling : available(req.roomId, req.slot)
Scheduling --> ConflictV : boolean
alt conflict free
  ConflictV --> Service : ValidationResult.ok()
else conflict found
  ConflictV -> Scheduling : suggest(req)
  Scheduling --> ConflictV : best: Room
  ConflictV --> Service : ValidationResult.ok(best)
end

Service -> DB : save(req)
Service -> Scheduling : block(req.roomId, req.slot)
Service -> Bus : publish(RESERVATION_REQUESTED)
Bus --> Service : ack

Service --> CreateCmd : ValidationResult.ok()
CreateCmd --> CommandBus : done
CommandBus --> prof : accepted (PENDING)
@enduml
