@startuml
title Sequence - Approve Reservation Request

actor Admin as admin
participant CommandBus
participant ApproveReservationCommand as ApproveCmd
participant ReservationService as Service
participant DatabaseConnection as DB
participant EventBus as Bus

admin -> CommandBus : dispatch(ApproveReservationCommand)
CommandBus -> ApproveCmd : execute(service)
ApproveCmd -> Service : approve(requestId, actor)

Service -> DB : exists(requestId)
DB --> Service : true
Service -> DB : markApproved(requestId)
Service -> Bus : publish(RESERVATION_APPROVED)
Bus --> Service : ack

Service --> ApproveCmd : success
ApproveCmd --> CommandBus : done
CommandBus --> admin : success
@enduml
