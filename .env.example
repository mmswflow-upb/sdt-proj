# Environment Variables for Campus Reservations Microservices
# Copy this file to .env and customize the values as needed

# JWT Secret Key
# This key is shared across all microservices for signing and verifying JWT tokens
# IMPORTANT: Change this to a strong, random secret in production
SECURITY_JWT_SECRET=mysecretkeymysecretkeymysecretkey

# Default Admin Credentials
# These credentials are used to create the initial admin user on first startup
# IMPORTANT: Change these values in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Database Credentials - Reservation Service
RESERVATION_DB_NAME=reservation
RESERVATION_DB_USER=reservation
RESERVATION_DB_PASSWORD=reservation

# Database Credentials - Scheduling Service
SCHEDULING_DB_NAME=scheduling
SCHEDULING_DB_USER=scheduling
SCHEDULING_DB_PASSWORD=scheduling

# Database Credentials - Faculty Service
FACULTY_DB_NAME=faculty
FACULTY_DB_USER=faculty
FACULTY_DB_PASSWORD=faculty

# RabbitMQ Configuration
# Message broker for asynchronous communication between services
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# RabbitMQ Exchange and Queue Names
RABBITMQ_EXCHANGE_RESERVATIONS=reservations.exchange
RABBITMQ_QUEUE_RESERVATION_CREATED=reservation.created
RABBITMQ_QUEUE_RESERVATION_CANCELLED=reservation.cancelled
RABBITMQ_QUEUE_RESERVATION_REVOKED=reservation.revoked
RABBITMQ_QUEUE_RESERVATION_APPROVED=reservation.approved

# RabbitMQ Dead Letter Exchange and Queue (for handling failed messages)
RABBITMQ_EXCHANGE_DLX=reservations.dlx
RABBITMQ_QUEUE_DLQ=reservation-dead-letter-queue

# RabbitMQ Message TTL (Time To Live in milliseconds)
# Messages will expire and be moved to DLQ if not consumed within this time
# Default: 60000 ms (60 seconds)
RABBITMQ_MESSAGE_TTL=60000
