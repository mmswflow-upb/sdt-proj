{
  "info": {
    "name": "01-Setup",
    "description": "Initial setup: login users, create faculty and room. Run this first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const jsonData = pm.response.json();",
              "  pm.environment.set('admin_token', jsonData.token);",
              "  pm.test('Admin logged in successfully', function () {",
              "    pm.expect(jsonData.token).to.exist;",
              "  });",
              "} else {",
              "  pm.test('Admin login failed', function () {",
              "    pm.expect.fail('Status ' + pm.response.code + ' - ' + pm.response.text());",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Register Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  pm.test('Student registered or already exists', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "  });",
              "} else if (pm.response.code === 409) {",
              "  pm.test('Student already exists', function () {",
              "    pm.expect(pm.response.code).to.eql(409);",
              "  });",
              "} else {",
              "  pm.test('Student registration failed', function () {",
              "    pm.expect.fail('Status ' + pm.response.code + ' - ' + pm.response.text());",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{student_username}}\",\n  \"password\": \"{{student_password}}\",\n  \"email\": \"student1@university.com\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
