          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const jsonData = pm.response.json();",
              "  const id = jsonData.id || jsonData.roomId;",
              "  pm.environment.set('room_id', id);",
              "  pm.test('Room created successfully', function () {",
              "    pm.expect(id).to.exist;",
              "  });",
              "} else {",
              "  pm.test('Room creation failed', function () {",
              "    pm.expect.fail('Status ' + pm.response.code + ' - ' + pm.response.text());",
              "  });",
              "}"
            ]
          }
        }
