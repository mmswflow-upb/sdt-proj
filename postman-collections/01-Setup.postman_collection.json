    {
      "name": "6. Create Test Faculty",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('faculty_external_id')) {",
              "  const id = 'TEST_FAC_' + Date.now();",
              "  pm.environment.set('faculty_external_id', id);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const jsonData = pm.response.json();",
              "  const id = jsonData.id || jsonData.facultyId;",
              "  pm.environment.set('faculty_id', id);",
              "  pm.test('Faculty created successfully', function () {",
              "    pm.expect(id).to.exist;",
              "  });",
              "} else {",
              "  pm.test('Faculty creation failed', function () {",
              "    pm.expect.fail('Status ' + pm.response.code + ' - ' + pm.response.text());",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"facultyId\": \"{{faculty_external_id}}\",\n  \"name\": \"Test Faculty {{faculty_external_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/faculties",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "faculties"
          ]
        }
      }
    },
    {
      "name": "7. Create Test Room",
