          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": \"{{faculty_external_id}}-ROOM-01\",\n  \"facultyId\": \"{{faculty_id}}\",\n  \"capacity\": 30,\n  \"equipment\": \"projector,whiteboard\"\n}"
        },
