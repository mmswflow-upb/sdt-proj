{
	"info": {
		"name": "Student Workflow",
		"description": "Complete student user journey - check availability, create reservations, cancel reservations",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/api",
			"type": "string"
		},
		{
			"key": "student_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "room_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "reservation_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Check Room Availability",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Can check availability', function() {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{student_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/availability?roomId={{room_id}}&from=2025-12-10T10:00:00&to=2025-12-10T12:00:00",
					"host": ["{{base_url}}"],
					"path": ["availability"],
					"query": [
						{
							"key": "roomId",
							"value": "{{room_id}}"
						},
						{
							"key": "from",
							"value": "2025-12-10T10:00:00"
						},
						{
							"key": "to",
							"value": "2025-12-10T12:00:00"
						}
					]
				}
			}
		},
		{
			"name": "2. Create Reservation",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200 || pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    pm.collectionVariables.set('reservation_id', jsonData.id || jsonData.reservationId);",
							"    pm.test('Reservation created', function() {",
							"        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{student_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"roomId\": \"{{room_id}}\",\n  \"startDateTime\": \"2025-12-10T10:00:00\",\n  \"endDateTime\": \"2025-12-10T12:00:00\",\n  \"attendees\": 20\n}"
				},
				"url": {
					"raw": "{{base_url}}/reservations",
					"host": ["{{base_url}}"],
					"path": ["reservations"]
				}
			}
		},
		{
			"name": "3. Get My Reservations",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Can view my reservations', function() {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{student_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/reservations/me",
					"host": ["{{base_url}}"],
					"path": ["reservations", "me"]
				}
			}
		},
		{
			"name": "4. Cancel Reservation",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Can cancel own reservation', function() {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{student_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/reservations/{{reservation_id}}/cancel",
					"host": ["{{base_url}}"],
					"path": ["reservations", "{{reservation_id}}", "cancel"]
				}
			}
		}
	]
}
