{
  "info": {
    "name": "02-Student-Workflow",
    "description": "Core student reservation workflow: availability, create, list, cancel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Prepare Reservation Time Window",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = new Date();",
              "const start = new Date(now.getTime() + 24 * 60 * 60 * 1000);",
              "const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);",
              "const toIso = (d) => d.toISOString().slice(0, 19);",
              "pm.environment.set('reservation_start', toIso(start));",
              "pm.environment.set('reservation_end', toIso(end));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "1. Check Room Availability",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Availability request succeeded', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/availability?roomId={{room_id}}&start={{reservation_start}}&end={{reservation_end}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "availability"
          ],
          "query": [
            {
              "key": "roomId",
              "value": "{{room_id}}"
            },
            {
              "key": "start",
              "value": "{{reservation_start}}"
            },
            {
              "key": "end",
              "value": "{{reservation_end}}"
            }
          ]
        }
      }
    },
    {
      "name": "2. Create Reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "  const jsonData = pm.response.json();",
              "  const id = jsonData.id || jsonData.reservationId;",
              "  pm.environment.set('reservation_id', id);",
              "  pm.test('Reservation created', function () {",
              "    pm.expect(id).to.exist;",
              "  });",
              "} else {",
              "  pm.test('Reservation creation failed', function () {",
              "    pm.expect.fail('Status ' + pm.response.code + ' - ' + pm.response.text());",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": \"{{room_id}}\",\n  \"startTime\": \"{{reservation_start}}\",\n  \"endTime\": \"{{reservation_end}}\",\n  \"attendees\": 10\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/reservations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations"
          ]
        }
      }
    },
    {
      "name": "3. Get My Reservations",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.test('Got my reservations list', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "  pm.expect(jsonData).to.be.an('array');",
              "});",
              "pm.test('Created reservation is present', function () {",
              "  const id = pm.environment.get('reservation_id');",
              "  const match = jsonData.find(r => (r.id || r.reservationId) === id);",
              "  pm.expect(!!match).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reservations/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations",
            "me"
          ]
        }
      }
    },
    {
      "name": "4. Cancel My Reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = pm.response.code;",
              "pm.test('Cancel returned success code', function () {",
              "  pm.expect(code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reservations/{{reservation_id}}/cancel",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{reservation_id}}",
            "cancel"
          ]
        }
      }
    }
  ]
}