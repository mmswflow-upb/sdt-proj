{
  "info": {
    "name": "5-Authorization-Tests",
    "description": "Negative authorization tests for student and faculty admin roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Student Cannot Approve Reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student cannot approve reservation', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([401,403]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reservations/{{main_reservation_id}}/approve",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{main_reservation_id}}",
            "approve"
          ]
        }
      }
    },
    {
