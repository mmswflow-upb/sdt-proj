{
  "info": {
    "name": "4-Edge-Cases",
    "description": "Edge cases: conflicts, overlaps, cancellations, and room deletion cascade.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Base Reservation (Student1)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = new Date();",
              "const start = new Date(now.getTime() + 48 * 60 * 60 * 1000);",
              "const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);",
              "const toIso = (d) => d.toISOString().slice(0, 19);",
              "pm.environment.set('edge_start', toIso(start));",
              "pm.environment.set('edge_end', toIso(end));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const jsonData = pm.response.json();",
              "  const id = jsonData.id || jsonData.reservationId;",
              "  pm.environment.set('edge_base_reservation_id', id);",
              "  pm.test('Base reservation created', function () {",
              "    pm.expect(id).to.exist;",
              "  });",
              "} else {",
              "  pm.test('Base reservation creation failed', function () {",
              "    pm.expect.fail('Status ' + pm.response.code + ' - ' + pm.response.text());",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": \"{{room_id_1}}\",\n  \"startDateTime\": \"{{edge_start}}\",\n  \"endDateTime\": \"{{edge_end}}\",\n  \"attendees\": 10\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/reservations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations"
          ]
        }
      }
    },
