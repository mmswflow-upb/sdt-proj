    {
      "name": "4. Overlapping Reservation (Should Fail)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date(pm.environment.get('edge_start') + 'Z');",
              "const end = new Date(pm.environment.get('edge_end') + 'Z');",
              "const overlapStart = new Date(start.getTime() + 30 * 60 * 1000);",
              "const overlapEnd = new Date(end.getTime() + 30 * 60 * 1000);",
              "const toIso = (d) => d.toISOString().slice(0,19);",
              "pm.environment.set('edge_overlap_start', toIso(overlapStart));",
              "pm.environment.set('edge_overlap_end', toIso(overlapEnd));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Overlapping reservation rejected', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([400,409]);",
              "});"
            ]
