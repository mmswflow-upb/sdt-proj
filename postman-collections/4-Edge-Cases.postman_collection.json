            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/schedules/{{delete_reservation_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "schedules",
            "{{delete_reservation_id}}"
          ]
        }
      }
    },
    {
      "name": "20. Availability for Deleted Room",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = new Date();",
              "const start = new Date(now.getTime() + 24 * 60 * 60 * 1000);",
              "const end = new Date(start.getTime() + 60 * 60 * 1000);",
              "const toIso = (d) => d.toISOString().slice(0,19);",
              "pm.environment.set('deleted_room_av_start', toIso(start));",
              "pm.environment.set('deleted_room_av_end', toIso(end));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Availability handles deleted room gracefully', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200,404]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/availability?roomId={{delete_room_id}}&from={{deleted_room_av_start}}&to={{deleted_room_av_end}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "availability"
          ],
          "query": [
            {
              "key": "roomId",
              "value": "{{delete_room_id}}"
            },
            {
              "key": "from",
              "value": "{{deleted_room_av_start}}"
            },
            {
              "key": "to",
              "value": "{{deleted_room_av_end}}"
            }
          ]
        }
      }
    }
  ]
}
