{
  "info": {
    "name": "1-Setup",
    "description": "Setup: admin login, base faculty, rooms, policy, and core users.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const jsonData = pm.response.json();",
              "  pm.environment.set('admin_token', jsonData.token);",
              "  pm.test('Admin logged in successfully', function () {",
              "    pm.expect(jsonData.token).to.exist;",
              "  });",
              "} else {",
              "  pm.test('Admin login failed', function () {",
              "    pm.expect.fail('Status ' + pm.response.code + ' - ' + pm.response.text());",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Create Test Faculty",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('faculty_external_id')) {",
              "  const id = 'TEST_FAC_' + Date.now();",
              "  pm.environment.set('faculty_external_id', id);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const jsonData = pm.response.json();",
              "  const id = jsonData.id || jsonData.facultyId || pm.environment.get('faculty_external_id');",
              "  pm.environment.set('faculty_id', id);",
              "  pm.test('Faculty created successfully', function () {",
              "    pm.expect(id).to.exist;",
              "  });",
              "} else {",
              "  pm.test('Faculty creation failed', function () {",
              "    pm.expect.fail('Status ' + pm.response.code + ' - ' + pm.response.text());",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"facultyId\": \"{{faculty_external_id}}\",\n  \"name\": \"Test Faculty {{faculty_external_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/faculties",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "faculties"
          ]
        }
      }
    },
