{
  "info": {
    "name": "Authorization-Tests",
    "description": "Negative authorization tests for student and faculty admin roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Student Cannot Approve Reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student is blocked from approving', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reservations/{{reservation_id}}/approve",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{reservation_id}}",
            "approve"
          ]
        }
      }
    },
    {
      "name": "2. Student Cannot Create Room",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student is blocked from creating rooms', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": \"STUDENT_ROOM_FORBIDDEN\",\n  \"facultyId\": \"{{faculty_id}}\",\n  \"capacity\": 10,\n  \"equipment\": \"whiteboard\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/rooms",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rooms"
          ]
        }
      }
    },
    {
      "name": "3. Student Cannot Create Faculty",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student is blocked from creating faculties', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"facultyId\": \"STUDENT_FAC_FORBIDDEN\",\n  \"name\": \"Forbidden Faculty\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/faculties",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "faculties"
          ]
        }
      }
    },
    {
      "name": "4. Faculty Admin Cannot Create Faculty",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Faculty admin is blocked from creating faculties', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{faculty_admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"facultyId\": \"FACADMIN_FORBIDDEN\",\n  \"name\": \"Forbidden Faculty\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/faculties",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "faculties"
          ]
        }
      }
    }
  ]
}