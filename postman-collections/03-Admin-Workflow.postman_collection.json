{
  "info": {
    "name": "03-Admin-Workflow",
    "description": "Admin operations: list reservations, approve / revoke, list rooms.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. List All Reservations",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.test('Admin can list reservations', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "  pm.expect(jsonData).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reservations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations"
          ]
        }
      }
    },
    {
      "name": "2. Approve Reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Approve reservation responded OK', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reservations/{{reservation_id}}/approve",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{reservation_id}}",
            "approve"
          ]
        }
      }
    },
    {
      "name": "3. Revoke Reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Revoke reservation responded OK', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reservations/{{reservation_id}}/revoke",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{reservation_id}}",
            "revoke"
          ]
        }
      }
    },
    {
      "name": "4. Approve Reservation Again",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Re-approve reservation responded OK', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reservations/{{reservation_id}}/approve",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "reservations",
            "{{reservation_id}}",
            "approve"
          ]
        }
      }
    },
    {
      "name": "5. List All Rooms",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.test('Admin can list rooms', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "  pm.expect(jsonData).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/rooms",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "rooms"
          ]
        }
      }
    }
  ]
}