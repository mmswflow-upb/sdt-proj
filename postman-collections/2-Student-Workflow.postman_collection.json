						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{student_token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"roomId\": \"{{room_id_1}}\",\n  \"startDateTime\": \"{{concurrent_start}}\",\n  \"endDateTime\": \"{{concurrent_end}}\",\n  \"attendees\": 5\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/reservations",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"reservations"
					]
				}
			},
			"response": []
